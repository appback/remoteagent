{
  "name": "appback-remoteagent",
  "version": "0.31.1",
  "description": "Personal installable session server for continuing local AI work across PC and Telegram",
  "license": "MIT",
  "type": "module",
  "bin": {
    "remoteagent": "bin/remoteagent.js",
    "remoteagent-install": "scripts/install.sh",
    "remoteagent-start": "scripts/start.sh",
    "remoteagent-stop": "scripts/stop.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "selftest:dot": "npm run build && node --test scripts/selftest-dot.mjs",
    "selftest:dot-host": "npm run build && node --test scripts/selftest-dot-host.mjs",
    "selftest:dot-mac": "npm run build && node --test scripts/selftest-dot-mac.mjs",
    "selftest:dot-login": "npm run build && node --test scripts/selftest-dot-login.mjs",
    "mac:install": "node scripts/install-mac-control.mjs",
    "selftest:dot-auth": "npm run build && node --test scripts/selftest-dot-owner-auth.mjs",
    "selftest:g2": "npm run build && node --test scripts/selftest-g2.mjs",
    "selftest:g2-browser": "npm run build && node scripts/selftest-g2-browser.mjs",
    "selftest:dot-browser": "npm run build && node scripts/selftest-dot-browser.mjs",
    "selftest:session-dispatch": "npm run build && node scripts/selftest-session-dispatch.mjs",
    "selftest:peer": "npm run build && node scripts/selftest-peer.mjs",
    "selftest:provider-install": "node scripts/selftest-provider-install.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "selftest:telegram": "npm run build && node scripts/selftest-telegram-update.mjs",
    "selftest:codex-stream": "npm run build && node scripts/selftest-codex-stream.mjs",
    "selftest:model-fallback": "npm run build && node scripts/selftest-model-fallback.mjs",
    "selftest:cli": "npm run build && node scripts/selftest-cli.mjs",
    "selftest:jev": "npm run build && node scripts/selftest-jev.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "node scripts/prepublish-guard.mjs",
    "release:version": "bash scripts/release-version.sh",
    "release:publish": "bash scripts/release-publish.sh",
    "release:deploy": "bash scripts/release-deploy.sh",
    "maintenance:disk": "bash scripts/disk-maintenance.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "^16.6.1",
    "grammy": "^1.38.3",
    "oidc-provider": "9.12.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "@types/oidc-provider": "^9.12.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example",
    "package.json",
    "tsconfig.json"
  ]
}
